# Public Supabase configuration.
# These values may be exposed to browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Playwright Actions E2E (local only — never commit real values).
# Prefer E2E_* ; M14_TEST_* is also accepted by the auth setup.
# E2E_EMAIL=
# E2E_PASSWORD=
# PLAYWRIGHT_ORG_ID=

# Privileged server-only Supabase configuration.
# Never expose this variable through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# M5.6C / M5-HR1.a internal metric recompute trigger. Disabled unless set to 1.
# The secret must be at least 32 characters and is server-only.
# When enabled, METRIC_RECOMPUTE_ORGANIZATION_ID must be exactly one UUID
# (server env only; never from the HTTP caller). Missing/invalid → 503,
# zero queue RPCs (no global fallback). Leave unset; do not enable casually.
METRIC_RECOMPUTE_WORKER_ENABLED=
METRIC_RECOMPUTE_WORKER_SECRET=
METRIC_RECOMPUTE_ORGANIZATION_ID=
# Optional F2 containment concurrency (integers 1-4). Absent → 1 / 1.
METRIC_RECOMPUTE_MAX_ACTIVE=
METRIC_RECOMPUTE_CLAIM_LIMIT=

# M5.6D / M5-HR1.b internal daily metric rollover trigger. Disabled unless set to 1.
# The secret must be at least 32 characters and is server-only.
# When enabled, METRIC_ROLLOVER_ORGANIZATION_ID must be exactly one UUID
# (server env only; never from the HTTP caller; never from recompute org env).
# Missing/invalid → 503, zero enqueue RPCs (no global fallback). Leave unset;
# do not enable casually.
METRIC_ROLLOVER_WORKER_ENABLED=
METRIC_ROLLOVER_WORKER_SECRET=
METRIC_ROLLOVER_ORGANIZATION_ID=

# M5-HR3.1 Vercel Cron GET adapter auth (server-only). Must be ≥32 chars
# when cron adapters are used. Missing/short/mismatch → 401, zero RPCs.
# Does not select tenant. Leave unset; do not schedule crons casually.
# Adapters still require METRIC_*_WORKER_ENABLED=1 and org env UUIDs.
CRON_SECRET=
