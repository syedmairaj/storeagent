# Public Supabase configuration.
# These values may be exposed to browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Playwright Actions E2E (local only — never commit real values).
# Prefer E2E_* ; M14_TEST_* is also accepted by the auth setup.
# E2E_EMAIL=
# E2E_PASSWORD=
# PLAYWRIGHT_ORG_ID=

# Privileged server-only Supabase configuration.
# Never expose this variable through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# M5.6C internal metric recompute trigger. Disabled unless set to 1.
# The secret must be at least 32 characters and is server-only.
METRIC_RECOMPUTE_WORKER_ENABLED=
METRIC_RECOMPUTE_WORKER_SECRET=
# Optional F2 containment concurrency (integers 1-4). Absent → 1 / 1.
METRIC_RECOMPUTE_MAX_ACTIVE=
METRIC_RECOMPUTE_CLAIM_LIMIT=

# M5.6D internal daily metric rollover trigger. Disabled unless set to 1.
# The secret must be at least 32 characters and is server-only.
METRIC_ROLLOVER_WORKER_ENABLED=
METRIC_ROLLOVER_WORKER_SECRET=
