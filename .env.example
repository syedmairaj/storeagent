# Public Supabase configuration.
# These values may be exposed to browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privileged server-only Supabase configuration.
# Never expose this variable through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# M5.6C internal metric recompute trigger. Disabled unless set to 1.
# The secret must be at least 32 characters and is server-only.
METRIC_RECOMPUTE_WORKER_ENABLED=
METRIC_RECOMPUTE_WORKER_SECRET=
